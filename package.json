{
  "name": "@venqoo/brand",
  "version": "0.2.0",
  "description": "venqoo brand kit: palette, type contract, marks and SVG assets, plus \"Made by venqoo\" credit components for sites and apps built by venqoo.",
  "license": "MIT",
  "author": "venqoo GmbH (https://www.venqoo.com)",
  "homepage": "https://github.com/venqoo/brand#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/venqoo/brand.git"
  },
  "bugs": "https://github.com/venqoo/brand/issues",
  "keywords": [
    "venqoo",
    "brand",
    "logo",
    "colors",
    "credit",
    "footer",
    "impressum",
    "react"
  ],
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "assets",
    "README.md",
    "LICENSE",
    "BRAND.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./colors": {
      "types": "./dist/colors.d.ts",
      "default": "./dist/colors.js"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "default": "./dist/fonts.js"
    },
    "./marks": {
      "types": "./dist/marks.d.ts",
      "default": "./dist/marks.js"
    },
    "./credit": {
      "types": "./dist/credit/index.d.ts",
      "default": "./dist/credit/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./credit.css": "./dist/credit.css",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
